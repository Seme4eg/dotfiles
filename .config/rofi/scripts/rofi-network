#!/bin/env bash
# FIXME: #!/bin/env is non-portable, should be #!/usr/bin/env bash

# horrible, unreadable, but still a reference:
# https://github.com/P3rf/rofi-network-manager/blob/master/src/ronema

# #############################################################################
#                        somewhat of a 'config' section                       #
###############################################################################

kb_refresh="Control+r"
kb_restart="Control+R"
# toggle network, without submenu
kb_quick_connect="Control+Return"
# forget network, without submenu
kb_quick_forget="Alt+x"
kb_show_info="Alt+o" # show info like password, security, qr, ssid

backOption='← back'

_rofi() { rofi -dmenu -i "$@"; }

# #############################################################################
#                             'config' section end                            #
###############################################################################

assert_status() { [ "$1" -eq 1 ] && exit; }

wifi_on() { [ "$(nmcli radio wifi)" = "enabled" ]; }

# managed wifi adapters (connectable)
wifi_devs() {
  nmcli -t -f device,type,state device status |
    awk -F: '$2=="wifi" && $3!="unmanaged" {print $1}'
}

# ------------------------------------------------------------------ data ---

# terse scan of all adapters; unescape nmcli's \: \\ and emit tab-separated
# active|ssid|security|signal|device|freq
scan() {
  nmcli -t -f active,ssid,security,signal,device,freq device wifi list --rescan "${1:-no}" |
    awk '{
      gsub(/\\\\/,"\x02"); gsub(/\\:/,"\x01")
      n = split($0, f, ":"); line = ""
      for (i = 1; i <= n; i++) {
        gsub(/\x01/, ":", f[i]); gsub(/\x02/, "\\", f[i])
        line = line (i > 1 ? "\t" : "") f[i]
      }
      print line
    }'
}

# one row per ssid, best signal across adapters/bands wins; sorted by signal
# \037-separated (tab is IFS whitespace: read would collapse empty fields)
# ssid|security|signal|bestdev|activedevs|bands
aggregate() {
  awk -F'\t' '
    $2 == "" { next }
    {
      s = $2
      if (!(s in sig) || $4+0 > sig[s]+0) { sig[s] = $4; dev[s] = $5; sec[s] = $3 }
      if ($1 == "yes") act[s] = act[s] (act[s] ? "," : "") $5
      f = $6+0
      if (f < 3000) b24[s] = 1; else if (f < 5900) b5[s] = 1; else b6[s] = 1
    }
    END {
      for (s in sig) {
        band = (s in b24) ? "2.4" : ""
        if (s in b5) band = band (band ? "+" : "") "5"
        if (s in b6) band = band (band ? "+" : "") "6"
        printf "%s\037%s\037%s\037%s\037%s\037%s\n", s, sec[s], sig[s], dev[s], act[s], band
      }
    }
  ' | sort -t$'\037' -k3,3nr
}

declare -a SSIDS SECS SIGS DEVS ACTS BANDS
SCAN=

load_networks() {
  SCAN=$(scan "$1")
  MULTI_DEV=$(wifi_devs | sed -n 2p) # nonempty when 2+ adapters
  SSIDS=() SECS=() SIGS=() DEVS=() ACTS=() BANDS=()
  local ssid sec sig dev act band
  SSID_W=1 SEC_W=1 BAND_W=1
  while IFS=$'\037' read -r ssid sec sig dev act band; do
    SSIDS+=("$ssid") SECS+=("$sec") SIGS+=("$sig") DEVS+=("$dev") ACTS+=("$act") BANDS+=("$band")
    [ ${#ssid} -gt "$SSID_W" ] && SSID_W=${#ssid}
    [ ${#sec} -gt "$SEC_W" ] && SEC_W=${#sec}
    [ ${#band} -gt "$BAND_W" ] && BAND_W=${#band}
  done < <(aggregate <<<"$SCAN")
  [ "$SSID_W" -gt 32 ] && SSID_W=32
}

net_row() { # $1 idx
  local mark=' '
  [ "${ACTS[$1]}" ] && mark='>'
  printf "%s %-${SSID_W}.${SSID_W}s   %-${SEC_W}s   %-${BAND_W}s   %s%%" \
    "$mark" "${SSIDS[$1]}" "${SECS[$1]:--}" "${BANDS[$1]}" "${SIGS[$1]}"
  [ "${ACTS[$1]}" ] && [ "$MULTI_DEV" ] && printf '  @%s' "${ACTS[$1]}"
  printf '\n'
}

# Parses the list of known connections to see if it already contains the SSID.
# nmcli connection show -- more detailed list of saved networks
ssid_saved() { nmcli -g NAME connection | grep -Fqx "$1"; }

# -------------------------------------------------------------- actions ---

wifi_status() {
  if wifi_on; then
    echo "󰤭  Disable Wi-Fi ($kb_restart to restart)"
  else
    echo "󰤨  Enable Wi-Fi"
  fi
}

toggle_wifi() {
  if wifi_on; then
    nmcli radio wifi off
    say -e "Wifi turned off"
    show_menu
  else
    nmcli radio wifi on
    say -t 5000 -e "Wifi turned on. Scanning for networks..."
    show_menu
  fi
}

# main toggle row: 1 adapter = plain radio toggle, 2+ = chooser
# per-adapter disable = nmcli managed no (NM ignores it until re-enabled here)
adapter_menu() {
  local devs
  devs=$(nmcli -t -f device,type,state device status | awk -F: '$2=="wifi"{print $1":"$3}')
  if ! wifi_on || [ "$(wc -l <<<"$devs")" -le 1 ]; then
    toggle_wifi
    return
  fi

  local allOff="All Wi-Fi off" rows='' dev state choice
  while IFS=: read -r dev state; do
    if [ "$state" = "unmanaged" ]; then
      rows+="Enable $dev (disabled)"$'\n'
    else
      rows+="Disable $dev ($state)"$'\n'
    fi
  done <<<"$devs"

  choice=$(printf '%s\n%s%s' "$allOff" "$rows" "$backOption" |
    _rofi -theme-str '#entry { placeholder: "wifi:"; }')
  assert_status $?

  case "$choice" in
    "$allOff") toggle_wifi ;;
    Disable\ * | Enable\ *)
      dev=${choice#* }
      dev=${dev%% *}
      case "$choice" in
        Disable*) nmcli device set "$dev" managed no && say -e "Disabled $dev." ;;
        *) nmcli device set "$dev" managed yes && say -e "Enabled $dev." ;;
      esac
      show_menu
      ;;
    *) show_menu ;;
  esac
}

restart_wifi() {
  say -t 3000 -e "Restarting wifi"
  nmcli networking off && nmcli networking on
  show_menu
}

forget_ssid() { nmcli connection delete id "$1" && say -e "Deleted $1."; }

# 2+ wifi adapters: chooser sorted by this ssid's signal, best preselected
pick_dev() { # $1 ssid -> stdout device
  local -a devs
  mapfile -t devs < <(wifi_devs)
  [ ${#devs[@]} -eq 0 ] && {
    say -e "No wifi adapter."
    return 1
  }
  [ ${#devs[@]} -eq 1 ] && {
    echo "${devs[0]}"
    return
  }

  local rows choice
  rows=$(awk -F'\t' -v s="$1" '
    $2 == s && ($4+0 > best[$5]+0 || !($5 in best)) { best[$5] = $4 }
    END { for (d in best) print best[d] "\t" d }
  ' <<<"$SCAN" | sort -nr | awk -F'\t' '{ printf "%-12s %s%%\n", $2, $1 }')
  [ "$rows" ] || rows=$(printf '%s\n' "${devs[@]}")

  choice=$(printf '%s\n%s' "$rows" "$backOption" |
    _rofi -theme-str '#entry { placeholder: "adapter:"; }')
  [ "$choice" ] || return 1
  [ "$choice" = "$backOption" ] && return 2
  echo "${choice%% *}"
}

toggle_ssid() { # $1 idx, $2 device (set on retry)
  local ssid="${SSIDS[$1]}" sec="${SECS[$1]}" dev="$2"

  if [ "${ACTS[$1]}" ]; then
    nmcli connection down id "$ssid" && say -e "Disconnected from $ssid."
    return
  fi

  if [ -z "$dev" ]; then
    dev=$(pick_dev "$ssid")
    case $? in
      2)
        show_menu
        return
        ;;           # back
      1) return 1 ;; # esc
    esac
  fi

  if ssid_saved "$ssid"; then
    say -t 2000 -e "Connecting to $ssid..."
    nmcli connection up id "$ssid" ifname "$dev" && say -e "Connected to $ssid."
    return
  fi

  local pass=
  if [ "$sec" ] && [ "$sec" != "--" ]; then
    pass=$(_rofi -password -theme-str '#entry { placeholder: "password .."; }' </dev/null)
    [ "$pass" ] || return 1
  fi

  say -t 2000 -e "Connecting to $ssid..."
  # FIXME: password on nmcli argv (visible in /proc); acceptable for personal box
  local -a cmd=(nmcli device wifi connect "$ssid" ifname "$dev")
  [ "$pass" ] && cmd+=(password "$pass")

  # variable to save the connection command error, because often needed
  local error
  # if connection failed - prompt again and remove attempted connection from
  # saved ones (cuz it does save connection even if wrong pass was provided)
  if ! error=$("${cmd[@]}" 2>&1 >/dev/null); then
    nmcli connection delete id "$ssid" >/dev/null 2>&1
    if [[ "$error" == *"activation failed"* ]]; then
      say -e Nope
      toggle_ssid "$1" "$dev"
    else
      # if there is some other error i most likely don't need a retry
      say "$error"
      return 1
    fi
  else
    say -e "Connected to $ssid."
  fi
}

show_qr() { # $1 ssid
  local ssid="$1" sec pass img
  pass=$(nmcli -s -g 802-11-wireless-security.psk connection show "$ssid")
  sec=$(nmcli -g 802-11-wireless-security.key-mgmt connection show "$ssid")
  case "$sec" in
    '') sec=nopass ;;
    none) sec=WEP ;;
    *) sec=WPA ;;
  esac

  # https://github.com/zxing/zxing/wiki/Barcode-Contents#wi-fi-network-config-android-ios-11
  esc() { sed 's/[\\;,:"]/\\&/g' <<<"$1"; }
  img=$(mktemp --suffix=.png)
  qrencode -t png -o "$img" -s 25 "WIFI:S:$(esc "$ssid");T:$sec;P:$(esc "$pass");;"

  _rofi -theme-str "
entry{enabled:false;}
textbox-prompt-colon{str:\"\";}
window{
  border-radius:6mm; padding:1mm; width:100mm; height:100mm;
  background-image:url(\"$img\",both);
}" </dev/null

  rm -f "$img"
}

show_info() {
  local -a options
  options=("$(nmcli connection show --show-secrets "$1" | grep -wE 'ssid:|key-mgmt:|psk:')" "$backOption")

  printf '%s\n' "${options[@]}" | _rofi
  assert_status $?
  show_menu
}

# A submenu for a specific device that allows connecting, pairing, and trusting
ssid_menu() { # $1 idx
  local idx="$1" ssid="${SSIDS[$1]}"
  local connected saved="Forget ($kb_quick_forget)" info="Show info & pass ($kb_show_info)"
  local qrOption="Generate QR" action

  if [ "${ACTS[$idx]}" ]; then
    connected="Disconnect ($kb_quick_connect)"
  else
    connected="Connect ($kb_quick_connect)"
  fi

  local -a options=("$connected" "$saved" "$info")
  command -v qrencode >/dev/null && options+=("$qrOption")
  options+=("$backOption")

  # Open rofi menu, read chosen option
  action=$(
    printf '%s\n' "${options[@]}" | _rofi \
      -mesg "All hotkeys shown are available from main menu" \
      -kb-custom-1 "$kb_quick_connect" \
      -kb-accept-custom "" \
      -kb-custom-2 "$kb_quick_forget" \
      -kb-custom-3 "$kb_show_info" \
      -theme-str "#entry { placeholder: \"$ssid:\"; }"
  )
  rofi_exit=$?
  assert_status $rofi_exit

  # pressed keybinding is more important than selected entry
  # Match action option to command
  case "$rofi_exit:$action" in
    10:* | 0:"$connected") toggle_ssid "$idx" ;;
    11:* | 0:"$saved") forget_ssid "$ssid" ;;
    12:* | 0:"$info") show_info "$ssid" ;;
    0:"$qrOption") show_qr "$ssid" ;;
    0:"$backOption") show_menu ;;
    *) echo "No option chosen." ;;
  esac
}

# autoupdate network list
# FIXME: background rescan poll every 1s - battery drain, interferes with connects
update_networks() {
  local cur=${#SSIDS[@]} new
  while true; do
    sleep 1
    new=$(scan auto | aggregate | wc -l)
    # -w for 'wait' to not spam tnose notification until user refreshes
    [ "$new" -ne "$cur" ] && say -w -e "Networks changed, refresh ($kb_refresh)"
  done
}

show_menu() { # $1 rescan mode for nmcli (no|auto|yes)
  local state idx i sel=0
  state=$(wifi_status)
  load_networks "$1"

  local -a rows=("$state")
  if wifi_on; then
    for i in "${!SSIDS[@]}"; do
      rows+=("$(net_row "$i")")
      [ "$sel" -eq 0 ] && [ "${ACTS[$i]}" ] && sel=$((i + 1))
    done
  fi

  # start background networks list updating, and kill it later by pid
  # start it as soon as possible
  update_networks &
  update_pid=$!
  trap 'kill $update_pid 2>/dev/null' EXIT

  # rofi 2.0 quirk: plain -format i prints -1 on kb-custom keys; 'i s' works
  idx=$(printf '%s\n' "${rows[@]}" | _rofi -format 'i s' -selected-row "$sel" \
    -kb-custom-1 "$kb_quick_connect" \
    -kb-accept-custom "" \
    -kb-custom-2 "$kb_quick_forget" \
    -kb-custom-3 "$kb_show_info" \
    -kb-custom-4 "$kb_refresh" \
    -kb-custom-5 "$kb_restart" \
    -theme-str '#entry { placeholder: "Wi-Fi SSID:"; }')
  rofi_exit=$?

  kill $update_pid 2>/dev/null
  assert_status $rofi_exit
  idx=${idx%% *}                         # strip ssid text, index is authoritative
  [ "$idx" ] && [ "$idx" -ge 0 ] || exit # typed custom input

  local nid=$((idx - 1)) # rows[0] is the wifi toggle

  case $rofi_exit in
    0)
      if [ "$idx" -eq 0 ]; then
        adapter_menu
      # no point in showing a 1-entry submenu if ssid isn't saved
      elif ssid_saved "${SSIDS[$nid]}"; then
        ssid_menu "$nid"
      else
        toggle_ssid "$nid"
      fi
      ;;
    10) [ "$idx" -gt 0 ] && toggle_ssid "$nid" ;;
    11) [ "$idx" -gt 0 ] && forget_ssid "${SSIDS[$nid]}" ;;
    12) [ "$idx" -gt 0 ] && show_info "${SSIDS[$nid]}" ;;
    13) show_menu auto ;;
    14) restart_wifi ;;
    *) exit ;;
  esac
}

show_menu

exit 0
