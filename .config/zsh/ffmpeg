###############################################################################
#                                Filter strings                               #
###############################################################################

# https://ffmpeg.org/ffmpeg-filters.html#afftdn
# - noise_reduction, nr - doesn't do much even if setting it to 90db
# - noise_floor, nf - couldn't decide on 35/40 value, 35 is less 'high' tones
#    hence less 'clear' audio but also less white noise, but on 40 this white
#    noise is more noticable. For now i think i prefer value of 35.
# - running default values for this filter results in still noisy audio, tad bit
#    better, but way worse than with 2 params below
# - adaptivity, ad - also doesn't seem affect the output noticably
# - band_multiplyer, bm - also doesn't seemingly affect anything
# - gain_smooth, gs - does smooth out the high noise of the audio, but setting
#    value to max (50) results in voice muffled sometimes and changing. Went for
#    15 for now
# - noise_link, nl - also didn't hear any difference
# - residual_floor, rf - works, using
# - track_noise, tn - works, using
#
# https://ffmpeg.org/ffmpeg-filters.html#speechnorm
# - the 'speechnorm' filter with all default values only makes white noise in my
#    case louder.
#
# NOTE: if you will get tired of 'muffled' sound use either of these options:
#  - use default 'afftdn' filter with all default params - voice will be clear,
#    original, but lots of white noise still.
#  - -nf=-40 (or -35) - will make voice bit more 'muffled', but bit less noise
#    and voise will still be clearer than with tracking and smoothing.
denoise="afftdn=tn=1:tr=1:gs=15"

# https://ffmpeg.org/ffmpeg-filters.html#silenceremove
desilence="silenceremove=stop_periods=-1:stop_duration=2:stop_threshold=-50dB"

# https://medium.com/@jud.dagnall/dynamic-range-compression-for-audio-with-ffmpeg-and-compand-621fe2b1a892
# -80/-900: Remove the really quiet stuff. (i removed it for now)
# -45/-15: Make the quietest part of the audience questions pretty clear(a 3x increase). You will likely need to fiddle with this if there’s a lot of audience noise, chairs moving, etc… that you don’t want to hear.
# -27/-9: make the medium part of the questions easy to hear.
# 0/-7: take what should be about the loudest part, and decrease it all the way down to -7. That means all the normal and loud stuff ends up between -9 and -7. The shouting still seems loud if it goes on for very long, because it’s just a lot more sound at the top volume. But it’s not jarring any more.
# 20/-7: Add another anchor just to be sure nothing ends up louder that -7.
boost="compand=attacks=0:points=-45/-15|-27/-9|0/-7|20/-7:gain=5"

###############################################################################
#                               Filter functions                              #
###############################################################################

ffpp() {
  # simple and complex filters can't b used together for same stream
  ffmpeg -i "${1}" -filter_complex \
    "[0:a]${desilence},${boost},${denoise}[postprocessed]" \
    -map "[postprocessed]" \
    -b:a 48k "pp_${1}"
}

ffdenoise() {
  ffmpeg -i "${1}" -af "${denoise}" -b:a 48k "denoised_${1}"
}

ffdesilence() {
  ffmpeg -i "${1}" -af "${desilence}" -b:a 48k "desilenced_${1}"
}

ffboost() {
  ffmpeg -i "${1}" -filter_complex "${boost}" -b:a 48k "boosted_${1}"
}

# --------------

# TLDR: you need the -crf flag most likely
# ---
# -crf - Constant Rate Factor controls the quality and compression level of the
#        video. Higher value - lower quality.
# -c:a aac - audio codec
# -b:a - audio bitrate
# -an - disable audio
# -c:v libsvtav1 - AV1 video codec; VMAF-tested on Pixel clips: crf 40 beats
#                  libx264 crf 28 in quality at 20-35% smaller size
#                  (crf 35 = same size as x264 crf 28, higher quality)
# -preset 5 - libsvtav1 speed preset (0 = slowest/best, 13 = fastest)
# -c:a copy - keep source audio as is (no re-encode generation loss)
# -map_metadata 0 - keep creation_time (ffmpeg drops it by default)
# -fps_mode passthrough - keep source frame timestamps (mp4 defaults to CFR,
#                         which dups/drops frames of variable-rate phone video)
# -vf scale=... - downscale to 1080p: short side capped at 1080 (portrait or
#                 landscape), -2 keeps aspect with even size, never upscales
# systemd-run ... CPUQuota - cap encode at 80% of all cores (quota is per core,
#                            hence nproc * 80); nice 19 lets desktop apps go first
# -y - overwrite existing output: a partial one left by Ctrl+C must be redone.
#      With -n ffmpeg skips it yet exits 0, and the original got trashed.
# Why not GPU (av1_vaapi on Intel Arc iGPU / AMD RX 7600, both work here):
#   3-10x faster, but needs 50-70% bigger files for the same VMAF (16 s HDR
#   clip: SVT p5 4.9 MB VMAF 96.4 vs AMD 8.25 MB VMAF 95.9). Hardware encoders
#   are fixed-function blocks with a per-block time budget, so they search far
#   fewer partitions/references/rate decisions than software; independent tests
#   put SVT-AV1 ahead of every hardware AV1 encoder (arXiv 2511.18686,
#   giannirosato.com/blog/post/nvenc-v-qsv). AMD output also decodes 1920x1082.
#   Fine for streaming, wrong trade for an archive. Faster CPU option: -preset 8
#   (~2.5x faster than p5, ~25% bigger files).
vidcompress() {
  if [[ -z "$1" || ! -f "$1" ]]; then
    echo "usage: vidcompress <video-file>" >&2
    return 1
  fi
  local dir base
  local crf=40
  dir=$(dirname -- "$1")
  base=$(basename -- "$1")
  out="${dir}/${base%.*}.crf${crf}.mp4"
  systemd-run --user --scope -q -p CPUQuota=$(($(nproc) * 80))% nice -n 19 \
    ffmpeg -nostdin -y -i "$1" \
    -map_metadata 0 -fps_mode passthrough \
    -vf "scale='if(gte(iw,ih),-2,min(iw,1080))':'if(gte(iw,ih),min(ih,1080),-2)'" \
    -c:v libsvtav1 -preset 5 -crf "$crf" \
    -c:a copy \
    -movflags +faststart \
    "$out" || return 1
  if [[ -s "$out" ]]; then
    # ffmpeg rewrites location ©xyz -> loci (~1 m rounding) and drops
    # com.android.* keys (model, make, capture fps); copy them back as is
    exiftool -q -q -overwrite_original -tagsFromFile "$1" \
      -UserData:all -Keys:all "$out" || {
      echo "metadata copy failed, keeping original: $1" >&2
      return 1
    }
    touch -r "$1" "$out"
    gio trash "$1"
  else
    echo "output missing/empty, keeping original: $1" >&2
    return 1
  fi
}

# List mp4 files under dir (default: .) whose video bitrate exceeds
# threshold (default: 13 Mb/s) — i.e. not yet compressed.
# 13 Mb/s: above old x264 crf28 outputs (max 12.2), below phone originals
# (Pixel 1080p HEVC ~19.8, Samsung 1080p H.264 ~17.6).
# Own .crfNN outputs are skipped by name: high-motion AV1 1080p60 can
# exceed 13 Mb/s. ffprobe runs on all cores. On a terminal: single updating
# counter line instead of the list.
vidfind_uncompressed() {
  local dir="${1:-.}" threshold="${2:-13000000}" tty
  [[ -t 1 ]] && tty=1
  find "$dir" -type f -iname '*.mp4' ! -iname '*.crf[0-9]*.mp4' -print0 |
    xargs -0 -r -P "$(nproc)" -n 1 zsh -fc '
      br=$(ffprobe -v error -select_streams v:0 \
        -show_entries stream=bit_rate -of default=nw=1:nk=1 "$1")
      # some containers lack per-stream bitrate -> fall back to overall
      [[ $br == <-> ]] || br=$(ffprobe -v error \
        -show_entries format=bit_rate -of default=nw=1:nk=1 "$1")
      [[ $br == <-> ]] && print -r -- "$br $1"' _ |
    awk -v t="$threshold" -v tty="$tty" '
      { n++; br = $1; sub(/^[0-9]+ /, "") }
      br > t { m++; if (!tty) { print; fflush() } }
      tty { printf "\rscanned %d, uncompressed %d", n, m > "/dev/stderr" }
      END { if (tty) print "" > "/dev/stderr" }'
}

# Compress every mp4 under dir (default: .) whose video bitrate
# exceeds threshold (default: 13 Mb/s).
vidcompress_all() {
  local f
  vidfind_uncompressed "${1:-.}" "${2:-13000000}" |
    while IFS= read -r f; do
      echo "compressing: $f"
      vidcompress "$f"
    done
}
