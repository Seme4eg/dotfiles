#!/usr/bin/env bash
# Grab one static background frame per video from a YouTube channel.
# Idempotent: re-run to retry only what's missing or invalid.
set -uo pipefail

# --- tuning constants (rarely need changing) ---
FRAC_LIST=(50 40 60 30 70) # seek points to try, as % of duration
MAX_PASSES=3               # retry passes before giving up
SLEEP_REQ=0.25             # delay between metadata requests, per worker
URL_TTL=18000              # re-sign CDN urls older than 5h
MIN_WIDTH=1280             # reject frames narrower than this
MIN_YAVG=20                # reject black / faded frames
MIN_SPREAD=10              # reject flat / uniform frames
FMT_SORT="res,br"          # highest res, then highest bitrate -- yt-dlp's
# default prefers av1 on codec rank alone, which at equal resolution can be a
# 3x lower-bitrate stream and gives a visibly softer, blockier single frame.

validate() { # one ffmpeg call: resolution + luma stats
  local f=$1 out dim w yavg ylow yhigh
  [ -s "$f" ] || return 1
  out=$(ffmpeg -nostdin -v info -i "$f" -vf "signalstats,metadata=print" -f null - 2>&1) || return 1
  dim=$(grep -m1 'Stream #0:0.*Video:' <<<"$out" | grep -m1 -oE '[0-9]{2,5}x[0-9]{2,5}')
  w=${dim%x*}
  [ -n "$w" ] && [ "$w" -ge "$MIN_WIDTH" ] || return 1
  yavg=$(sed -n 's/.*signalstats\.YAVG=\([0-9.]*\).*/\1/p' <<<"$out" | head -1)
  ylow=$(sed -n 's/.*signalstats\.YLOW=\([0-9.]*\).*/\1/p' <<<"$out" | head -1)
  yhigh=$(sed -n 's/.*signalstats\.YHIGH=\([0-9.]*\).*/\1/p' <<<"$out" | head -1)
  [ -n "$yavg" ] && [ -n "$ylow" ] && [ -n "$yhigh" ] || return 1
  awk -v a="$yavg" -v l="$ylow" -v h="$yhigh" -v ma="$MIN_YAVG" -v ms="$MIN_SPREAD" \
    'BEGIN{ exit !(a>=ma && (h-l)>=ms) }'
}

validate_cached() { # skip re-decoding a file already proven good
  local f=$1 cache=$2 key
  [ -s "$f" ] || return 1
  key=$(stat -c '%n	%s	%Y' "$f" 2>/dev/null) || return 1
  grep -qxF "$key" "$cache" 2>/dev/null && return 0
  validate "$f" || return 1
  printf '%s\n' "$key" >>"$cache"
}

# --check <cache> <dest>                           (invoked by xargs)
if [ "${1:-}" = "--check" ]; then
  validate_cached "$3" "$2"
  exit $?
fi

# --worker <id> <dur> <dest> <urlfile> <workdir>   (invoked by xargs)
if [ "${1:-}" = "--worker" ]; then
  id=$2 dur=$3 dest=$4 urlfile=$5 work=$6
  url=$(cat "$urlfile" 2>/dev/null)
  [ -n "$url" ] || {
    echo "$id"$'\t'"no-url" >>"$work/fail.tsv"
    echo "FAIL $id"
    exit 1
  }
  tmp="$dest.tmp.png"
  for frac in "${FRAC_LIST[@]}"; do
    t=$((dur * frac / 100))
    err=$(ffmpeg -nostdin -loglevel error -y -ss "$t" -i "$url" \
      -frames:v 1 -pix_fmt rgb24 "$tmp" </dev/null 2>&1)
    if [ $? -eq 0 ] && validate "$tmp"; then
      mv -f "$tmp" "$dest"
      echo "OK $id"
      exit 0
    fi
    case "$err" in
      *403* | *Forbidden*)
        rm -f "$urlfile"
        break
        ;; # expired: re-sign next pass
    esac
  done
  rm -f "$tmp"
  echo "$id"$'\t'"${err:0:120}" >>"$work/fail.tsv"
  echo "FAIL $id"
  exit 1
fi

usage() {
  cat >&2 <<EOF
usage: $(basename "$0") [-o DIR] [-j N] [-m N] [-n N] <channel>

  <channel>  channel name or full URL, e.g. FocusSoundscapesMusic
  -o DIR     output directory        (default: backgrounds)
  -j N       parallel frame fetches  (default: 16)
  -m N       parallel metadata workers, lower if rate-limited (default: 6)
  -n N       only the first N videos, for testing (default: all)
EOF
  exit 2
}

OUT=backgrounds
JOBS=16
META_JOBS=6
LIMIT=0
while getopts ':o:j:m:n:h' opt; do
  case $opt in
    o) OUT=$OPTARG ;;
    j) JOBS=$OPTARG ;;
    m) META_JOBS=$OPTARG ;;
    n) LIMIT=$OPTARG ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[ $# -eq 1 ] || usage

case "$1" in
  http://* | https://*) CHANNEL="$1" ;;
  *) CHANNEL="https://www.youtube.com/@${1#@}" ;;
esac

WORK="$OUT/.work"
mkdir -p "$OUT" "$WORK/urls"
SELF="$(readlink -f "$0")"
GOOD="$WORK/good.tsv"
VJOBS=$(($(nproc) / 2))
[ "$VJOBS" -lt 4 ] && VJOBS=4

# --- video list (cached) ---
if [ ! -s "$WORK/ids.tsv" ]; then
  echo "listing channel..."
  yt-dlp --flat-playlist --print $'%(id)s\t%(duration)s\t%(title)s' \
    "${CHANNEL%/}/videos" >"$WORK/ids.tsv" || exit 1
fi
[ "$LIMIT" -gt 0 ] && head -n "$LIMIT" "$WORK/ids.tsv" >"$WORK/ids.use.tsv" ||
  cp "$WORK/ids.tsv" "$WORK/ids.use.tsv"
echo "videos: $(wc -l <"$WORK/ids.use.tsv")"

progress() { # fold per-video worker results into one rewritten line
  local total=$1 ok=0 bad=0 r
  while IFS= read -r r; do
    case "$r" in
      OK\ *) ok=$((ok + 1)) ;;
      FAIL\ *) bad=$((bad + 1)) ;;
      *) continue ;;
    esac
    printf '\r[done %d] [failed %d] [remaining %d]' "$ok" "$bad" "$((total - ok - bad))"
  done
  printf '\n'
}

dest_for() { # id, title -> output path
  local safe
  safe=$(printf '%s' "$2" | tr -cd '[:alnum:] ._-' | cut -c1-80)
  printf '%s/%s_%s.png' "$OUT" "$safe" "$1"
}

for pass in $(seq 1 "$MAX_PASSES"); do
  : >"$WORK/todo.tsv"
  : >"$WORK/check.tsv"
  : >"$WORK/fail.tsv"

  # split into "no file yet" (straight to todo) and "needs validating"
  while IFS=$'\t' read -r id dur title; do
    case "$dur" in '' | NA | None) dur=600 ;; esac
    dur=${dur%.*}
    grep -qxF "$id" "$WORK/permanent.txt" 2>/dev/null && continue
    dest=$(dest_for "$id" "$title")
    if [ -s "$dest" ]; then
      printf '%s\t%s\t%s\n' "$id" "$dur" "$dest" >>"$WORK/check.tsv"
    else
      printf '%s\t%s\t%s\n' "$id" "$dur" "$dest" >>"$WORK/todo.tsv"
    fi
  done <"$WORK/ids.use.tsv"

  # validate existing frames in parallel, cached across passes
  if [ -s "$WORK/check.tsv" ]; then
    cut -f3 "$WORK/check.tsv" |
      xargs -d '\n' -P "$VJOBS" -I{} bash -c '"$0" --check "$1" "{}" || printf "%s\n" "{}"' \
        "$SELF" "$GOOD" >"$WORK/bad.txt"
    awk -F'\t' 'NR==FNR{bad[$0];next} ($3 in bad)' "$WORK/bad.txt" "$WORK/check.tsv" >>"$WORK/todo.tsv"
  fi

  n=$(wc -l <"$WORK/todo.tsv")
  [ "$n" -eq 0 ] && {
    echo "pass $pass: nothing left"
    break
  }
  echo "=== pass $pass: $n to do ==="

  # phase 1: metadata. one yt-dlp per worker, many videos per process --
  # player JS is fetched and cached once per process instead of per video.
  : >"$WORK/meta.todo"
  while IFS=$'\t' read -r id dur dest; do
    uf="$WORK/urls/$id.url"
    [ -s "$uf" ] && [ $(($(date +%s) - $(stat -c %Y "$uf"))) -lt "$URL_TTL" ] && continue
    echo "https://www.youtube.com/watch?v=$id" >>"$WORK/meta.todo"
  done <"$WORK/todo.tsv"

  m=$(wc -l <"$WORK/meta.todo")
  if [ "$m" -gt 0 ]; then
    echo "  signing $m urls ($META_JOBS workers)"
    rm -rf "$WORK/chunks"
    mkdir -p "$WORK/chunks"
    nchunk=$META_JOBS
    [ "$m" -lt "$nchunk" ] && nchunk=$m
    split -n "l/$nchunk" "$WORK/meta.todo" "$WORK/chunks/c"
    for c in "$WORK/chunks"/c*; do
      yt-dlp --ignore-errors --no-warnings --sleep-requests "$SLEEP_REQ" \
        -f "bv*[protocol^=http]" -S "$FMT_SORT" --print $'%(id)s\t%(url)s' \
        -a "$c" >"$c.out" 2>"$c.err" &
    done
    wait

    while IFS=$'\t' read -r id url; do
      case "$url" in https://*) printf '%s\n' "$url" >"$WORK/urls/$id.url" ;; esac
    done < <(cat "$WORK/chunks"/c*.out 2>/dev/null)

    ratelimited=0
    while IFS= read -r line; do
      case "$line" in
        *"Private video"* | *unavailable* | *"members-only"* | *removed* | \
          *"age-restricted"* | *"confirm your age"*)
          eid=$(sed -n 's/^ERROR: \[[^]]*\] \([^:]*\):.*/\1/p' <<<"$line")
          [ -n "$eid" ] || continue
          grep -qxF "$eid" "$WORK/permanent.txt" 2>/dev/null && continue
          echo "$eid" >>"$WORK/permanent.txt"
          echo "  skip $eid (permanent)"
          ;;
        *429* | *"not a bot"* | *"rate"*) ratelimited=1 ;;
      esac
    done < <(cat "$WORK/chunks"/c*.err 2>/dev/null)
    [ "$ratelimited" -eq 1 ] && {
      echo "  RATE-LIMITED -- backing off 120s (try a lower -m)"
      sleep 120
    }
  fi

  # phase 2: frame fetches, parallel (CDN tolerates this)
  awk -F'\t' -v w="$WORK" '{print $1"\t"$2"\t"$3"\t"w"/urls/"$1".url\t"w}' "$WORK/todo.tsv" |
    xargs -d '\n' -P "$JOBS" -I{} bash -c 'IFS=$'"'"'\t'"'"' read -r a b c d e <<< "{}"; "$0" --worker "$a" "$b" "$c" "$d" "$e"' "$SELF" |
    progress "$n"

  f=$(wc -l <"$WORK/fail.tsv" 2>/dev/null || echo 0)
  [ "$f" -eq 0 ] && {
    echo "pass $pass: all good"
    break
  }
  echo "pass $pass: $f failed"
  [ "$pass" -lt "$MAX_PASSES" ] && {
    echo "backoff $((pass * 15))s"
    sleep $((pass * 15))
  }
done

echo
echo "=== done: $(ls "$OUT"/*.png 2>/dev/null | wc -l) images in $OUT ==="
[ -s "$WORK/fail.tsv" ] && {
  echo "still failing:"
  cat "$WORK/fail.tsv"
}
[ -s "$WORK/permanent.txt" ] && echo "permanently skipped: $(wc -l <"$WORK/permanent.txt")"
exit 0
